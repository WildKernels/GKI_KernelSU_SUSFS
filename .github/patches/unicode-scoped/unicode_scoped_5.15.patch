 	if (force_o_largefile())
 		flags |= O_LARGEFILE;
 	return do_sys_open(dfd, filename, flags, mode);
@@ -1271,6 +1280,10 @@
 SYSCALL_DEFINE4(openat2, int, dfd, const char __user *, filename,
 		struct open_how __user *, how, size_t, usize)
 {
+	int uc_err = uc_path_check(filename);
+
+	if (uc_err)
+		return uc_err;
 	int err;
 	struct open_how tmp;
 
