From: Wild Kernels <kernel@wildkernels.dev>
Subject: [PATCH] ABI: use the pre-se alignment hole for SYSVIPC (6.6)

Port of DroidSpaces' GKI kernel-6.12 gap-trick to 6.6: task_struct's
`struct sched_entity se` is cacheline-aligned and Google's stock 6.6.14x
layout leaves 320+ bytes of alignment padding between `rt_priority` and
`se` (stock offsets: rt_priority@1152, padding@1216, se@1536 - measured
from the official prebuilt's abi-full.stg). Moving sysvsem/sysvshm into
packed unions placed in that hole changes ZERO offsets, so
CONFIG_SYSVIPC/IPC_NS can go on without consuming any ANDROID_KABI
reserve - leaving slots 3-8 free for the BORE slot-merge (bore66_state).

Based on nullptr-t-oss's DroidSpaces kernel-6.12 patch.
---
 include/linux/sched.h | 24 +++++++++++++++++++-----
 1 file changed, 19 insertions(+), 5 deletions(-)

diff --git a/include/linux/sched.h b/include/linux/sched.h
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -780,6 +780,17 @@ struct task_struct {
 	int				normal_prio;
 	unsigned int			rt_priority;
 
+#ifdef CONFIG_SYSVIPC
+	union {
+		char __kabi_ignored_0;
+		struct sysv_sem			sysvsem;
+	}__attribute__((packed));
+	union {
+		char __kabi_ignored_1;
+		struct sysv_shm			sysvshm;
+	}__attribute__((packed));
+#endif
+
 	struct sched_entity		se;
 	struct sched_rt_entity		rt;
 	struct sched_dl_entity		dl;
@@ -1074,8 +1085,8 @@ struct task_struct {
 	struct nameidata		*nameidata;
 
 #ifdef CONFIG_SYSVIPC
-	struct sysv_sem			sysvsem;
-	struct sysv_shm			sysvshm;
+	// struct sysv_sem		sysvsem;
+	// struct sysv_shm		sysvshm;
 #endif
 #ifdef CONFIG_DETECT_HUNG_TASK
 	unsigned long			last_switch_count;
-- 
2.43.0

