# Sourced by build/build.sh (_setup_env.sh) as a build config, not merged as
# Kconfig, so this file is shell. It is what points the legacy build at our
# post-defconfig fragment; CONFIG_ lines here would only become shell variables.
#
# The fragment must land in ${OUT_DIR}/common, not ${OUT_DIR}: build.sh runs
# mrproper, defconfig, olddefconfig and the build itself with O=${OUT_DIR}/common,
# so a merge into ${OUT_DIR}/.config writes a file nothing reads and the tree's
# own defaults win. That is how CONFIG_NTSYNC stayed =m after the fragment said
# =y - ntsync then built as a module and modpost rejected the link:
#
#   ERROR: modpost: "__vfs_setxattr_noperm" [drivers/misc/ntsync.ko] undefined!
#
# NTSYNC is also re-forced with scripts/config after the merge: the backport's
# entry is "tristate ... default m", and a fragment value that is re-resolved by
# olddefconfig on a tristate can drop back to that default. Built in, no .ko is
# emitted, so the GKI module list never sees a new entry either.
POST_DEFCONFIG_CMDS="( cd ${KERNEL_DIR} && scripts/kconfig/merge_config.sh -m -O ${OUT_DIR}/common ${OUT_DIR}/common/.config ${ROOT_DIR}/common/wild_defconfig.fragment && scripts/config --file ${OUT_DIR}/common/.config --enable NTSYNC && make O=${OUT_DIR}/common ARCH=arm64 olddefconfig )"
