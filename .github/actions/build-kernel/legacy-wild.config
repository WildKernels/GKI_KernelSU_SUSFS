# Build config fragment for the legacy (build/build.sh) path.
#
# Sourced by build/_setup_env.sh after common/build.config.gki, which means anything
# set here wins. This replaces editing build.config.gki in place: the stock file keeps
# POST_DEFCONFIG_CMDS="check_defconfig", and we layer the fragment merge on top of it.
#
# check_defconfig runs first, against the untouched gki_defconfig. It has to: it
# compares `make savedefconfig` output with the committed defconfig, so running it
# after the merge would diff our added options against a defconfig that never had
# them and fail on every build.
#
# Variables are single-quoted so they expand when build.sh evals the command, not now.

POST_DEFCONFIG_CMDS='check_defconfig && ${ROOT_DIR}/common/scripts/kconfig/merge_config.sh -m -O ${OUT_DIR} ${OUT_DIR}/.config ${ROOT_DIR}/common/wild_defconfig.fragment && (cd ${KERNEL_DIR} && make ${TOOL_ARGS[@]} O=${OUT_DIR} olddefconfig)'
